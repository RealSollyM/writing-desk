generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  role               UserRole           @default(WRITER)
  emailVerified      Boolean            @default(false)
  image              String?
  accounts           Account[]
  bookCollaborations BookCollaborator[]
  documents          Document[]
  sessions           Session[]
  documentVersions   DocumentVersion[]
  books              Book[]             @relation("UserBooks")
  ownedBooks         Book[]             @relation("BookOwner")

  @@map("users")
}

model Document {
  id         String         @id @default(cuid())
  versionId  String   @unique @default(dbgenerated("gen_random_uuid()"))
  title      String
  slug       String   @default("untitled")
  content    String
  status     DocumentStatus @default(DRAFT)
  authorId   String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book       Book?          @relation(fields: [bookId], references: [id])
  bookId     String?
  // Chapter fields
  order      Int?           @default(0)
  partId     String?
  part       Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(cuid())
  versionId     String   @unique
  documentId    String
  title         String
  content       String
  status        DocumentStatus @default(DRAFT)
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([authorId])
  @@map("document_versions")
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]   @relation("BookCollection")

  @@map("collections")
}

model Book {
  id           String             @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  genre        String?
  coverImage   String?
  isPublic     Boolean  @default(false)
  isPublished  Boolean  @default(false)
  ownerId      String
  owner        User     @relation("BookOwner", fields: [ownerId], references: [id])
  collection   Collection? @relation("BookCollection", fields: [collectionId], references: [id])
  collectionId String?
  documents    Document[]
  parts        Part[]
  collaborators BookCollaborator[]
  users        User[]   @relation("UserBooks")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@map("books")
}

model Part {
  id        String   @id @default(cuid())
  title     String
  slug      String
  order     Int
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  chapters  Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, slug])
  @@index([bookId, order])
  @@map("parts")
}

model BookCollaborator {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  role      BookRole
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("book_collaborators")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String?  @unique
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  provider              String?
  providerAccountId     String?
  refresh_token         String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  idToken               String?
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expiresAt  DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  ADMIN
  WRITER
  READER
}

enum BookRole {
  OWNER
  CO_WRITER
  CONTRIBUTOR
  GHOST_WRITER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}
